{
  "name": "lyth-vscode-color-theme",
  "displayName": "Lyth VS Code Color Theme",
  "description": "An attempt at a decently semantic VS Code theme for C++",
  "version": "0.2.0",
  "publisher": "Yuri Turov",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Lyth Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/lyth-dark.json"
      },
      {
        "label": "Lyth Dark Lum Tweak",
        "uiTheme": "vs-dark",
        "path": "./themes/lyth-dark-lum-tweak.json"
      },
      {
        "label": "Lyth Dark Mono",
        "uiTheme": "vs-dark",
        "path": "./themes/lyth-dark-mono.json"
      },
      {
        "label": "Lyth Dark Adjusted",
        "uiTheme": "vs-dark",
        "path": "./themes/lyth-dark-adjusted.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc && node .tsc/build.js",
    "watch": "tsc-watch --onSuccess \"node .tsc/build.js\"",
    "preinstall": "npm run build",
    "install": "tsc && node .tsc/install.js"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "typescript": "^4.5.0",
    "tsc-watch": "^4.6.0"
  }
}
