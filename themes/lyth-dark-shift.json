{
  "name": "Lyth Dark Shift",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1c1c1c",
    "editor.foreground": "#cecece",
    "activityBarBadge.background": "#007acc",
    "sideBarTitle.foreground": "#bbbbbb",
    "sideBar.background": "#1b1b1b",
    "editorCursor.foreground": "#d484ff",
    "editorCursor.background": "#000000",
    "editor.lineHighlightBackground": "#29222e",
    "editor.lineHighlightBorder": "#29222e",
    "editor.wordHighlightBackground": "#48535f3a",
    "editor.wordHighlightBorder": "#48535f",
    "editorBracketHighlight.foreground1": "#af8686",
    "editorBracketHighlight.foreground2": "#a8879c",
    "editorBracketHighlight.foreground3": "#af8686",
    "editorBracketHighlight.foreground4": "#a8879c",
    "editorBracketHighlight.foreground5": "#af8686",
    "editorBracketHighlight.foreground6": "#a8879c",
    "editorBracketHighlight.unexpectedBracket.background": "#31170f",
    "editorBracketHighlight.unexpectedBracket.foreground": "#f05400",
    "git.blame.editorDecorationForeground": "#3a4c43"
  },
  "semanticTokenColors": {
    "namespace": "#a17273",
    "macro": "#189384",
    "typeParameter": {
      "italic": true
    },
    "function.static": {
      "italic": true
    },
    "class.declaration": {
      "fontStyle": "bold"
    },
    "class.definition": {
      "fontStyle": "bold"
    },
    "class.constructorOrDestructor": "#83aefa",
    "type.defaultLibrary": "#9364b5",
    "class.deduced": "#9364b5",
    "variable.readonly": "#cfc1db",
    "bracket": "#af8686"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#59525e"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Constant Variable",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#cfc1db"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#d7d7d7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e94c00"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#9364b5"
      }
    },
    {
      "name": "Storage Modifier, noexcept",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#9364b5"
      }
    },
    {
      "name": "Requires Keyword",
      "scope": [
        "keyword.other.requires"
      ],
      "settings": {
        "foreground": "#9364b5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#9364b5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.template.cpp"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a4c8ee"
      }
    },
    {
      "name": "Pointer and Reference",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#a4c8ee"
      }
    },
    {
      "name": "Cast",
      "scope": [
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#6e4e84"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#da6e49"
      }
    },
    {
      "name": "Primitive Type",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#d37db8"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#df8e91"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#6aba9f"
      }
    },
    {
      "name": "Class, Struct, Type Declaration",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.typedef"
      ],
      "settings": {
        "foreground": "#df8e91"
      }
    },
    {
      "name": "Namespace Prefix",
      "scope": [
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#a17273"
      }
    },
    {
      "name": "Lambda Return Type",
      "scope": [
        "storage.type.return-type.lambda.cpp"
      ],
      "settings": {
        "foreground": "#b8ae78"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#83aefa"
      }
    },
    {
      "name": "Member Function",
      "scope": [
        "entity.name.function.definition",
        "keyword.other.operator.overload.cpp"
      ],
      "settings": {
        "foreground": "#83aefa",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Static Function",
      "scope": [
        "entity.name.function.member.static"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Special Function",
      "scope": [
        "entity.name.function.definition.special"
      ],
      "settings": {
        "foreground": "#a49bda",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#189384"
      }
    },
    {
      "name": "Property/Member Variables",
      "scope": [
        "variable.other.property",
        "variable.other.constant.property",
        "variable.other.object.property",
        "meta.body.class variable.other.declare"
      ],
      "settings": {
        "foreground": "#e0bdbe"
      }
    },
    {
      "name": "Local Variable Declaration",
      "scope": [
        "meta.body.function.definition variable.other.declare"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#e0bdbe"
      }
    },
    {
      "name": "Number, Constant, Tag Attribute, Embedded",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#e5a24d"
      }
    },
    {
      "name": "Argument",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword (Other)",
      "scope": [
        "keyword.other.unit",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#9364b5"
      }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#6fce9e"
      }
    },
    {
      "name": "String Template Expression",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#73d3f1"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#B2CCD6"
      }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Language methods",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#f24273"
      }
    },
    {
      "name": "entity.name.method.js",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "meta.method.js",
      "scope": [
        "meta.class-method.js entity.name.function.js",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "TypeScript Primitive",
      "scope": [
        "support.type.primitive.ts"
      ],
      "settings": {
        "foreground": "#d97baa"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9364b5"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "text.html.basic entity.other.attribute-name.html",
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#df8e91",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#df8e91"
      }
    },
    {
      "name": "CSS IDs",
      "scope": [
        "source.sass keyword.control"
      ],
      "settings": {
        "foreground": "#83aefa"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#6fce9e"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e94c00"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e180c9"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5dabd1"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3ed0c8"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": {
        "foreground": "#a49bda",
        "fontStyle": "italic"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#a4c8ee",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c1c1c1"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c6b9e3"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#dcb2cd"
      }
    },
    {
