{
  "name": "Lyth Dark Adjusted",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1c1c1c",
    "editor.foreground": "#d0d0d0",
    "activityBarBadge.background": "#007acc",
    "sideBarTitle.foreground": "#bbbbbb",
    "sideBar.background": "#1c1c1c",
    "editorCursor.foreground": "#d786ff",
    "editorCursor.background": "#000000",
    "editor.lineHighlightBackground": "#29222f",
    "editor.lineHighlightBorder": "#29222f",
    "editor.inactiveLineHighlightBackground": "#202020",
    "editor.wordHighlightBackground": "#4954603a",
    "editor.wordHighlightBorder": "#495460",
    "editor.selectionBackground": "#322c36",
    "editor.inactiveSelectionBackground": "#2b282d",
    "editor.selectionHighlightBackground": "#29262b",
    "editor.selectionHighlightBorder": "#3f3943",
    "editor.findMatchBackground": "#6c0000",
    "editor.findMatchHighlightBackground": "#650000",
    "editor.findMatchHighlightBorder": "#c4bdca",
    "editorBracketHighlight.foreground1": "#a87f7e",
    "editorBracketHighlight.foreground2": "#9782a0",
    "editorBracketHighlight.foreground3": "#a87f7e",
    "editorBracketHighlight.foreground4": "#9782a0",
    "editorBracketHighlight.foreground5": "#a87f7e",
    "editorBracketHighlight.foreground6": "#9782a0",
    "editorBracketHighlight.unexpectedBracket.background": "#32170f",
    "editorBracketHighlight.unexpectedBracket.foreground": "#f35600",
    "git.blame.editorDecorationForeground": "#3b4d44"
  },
  "semanticTokenColors": {
    "namespace": "#bd6f67",
    "macro": "#1c9586",
    "typeParameter": {
      "italic": true
    },
    "function.static": {
      "italic": true
    },
    "class.declaration": {
      "fontStyle": "bold"
    },
    "class.definition": {
      "fontStyle": "bold"
    },
    "class.constructorOrDestructor": "#85b0fc",
    "type.defaultLibrary": "#9a64b2",
    "class.deduced": "#9a64b2",
    "variable.readonly": "#d2c3de",
    "bracket": "#a87f7e"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b535e"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Constant Variable",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d2c3de"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#dadada"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#eb4e00"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#9a64b2"
      }
    },
    {
      "name": "Storage Modifier, noexcept",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#9a64b2"
      }
    },
    {
      "name": "Requires Keyword",
      "scope": [
        "keyword.other.requires"
      ],
      "settings": {
        "foreground": "#9a64b2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#9a64b2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.template.cpp"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a7cbf1"
      }
    },
    {
      "name": "Pointer and Reference",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#a7cbf1"
      }
    },
    {
      "name": "Cast",
      "scope": [
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#9a64b2"
      }
    },
    {
      "name": "Static Cast",
      "scope": [
        "keyword.operator.cast.static_cast"
      ],
      "settings": {
        "foreground": "#724e83"
      }
    },
    {
      "name": "Dynamic Cast",
      "scope": [
        "keyword.operator.cast.dynamic_cast"
      ],
      "settings": {
        "foreground": "#a871c0"
      }
    },
    {
      "name": "Reinterpret Cast",
      "scope": [
        "keyword.operator.cast.reinterpret_cast"
      ],
      "settings": {
        "foreground": "#a871c0"
      }
    },
    {
      "name": "Const Cast",
      "scope": [
        "keyword.operator.cast.const_cast"
      ],
      "settings": {
        "foreground": "#a871c0"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#dc704b"
      }
    },
    {
      "name": "Primitive Type",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in"
