{
  "name": "Lyth Dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1c1c1c",
    "editor.foreground": "#c7c7c9",
    "activityBarBadge.background": "#007acc",
    "sideBarTitle.foreground": "#bbbbbb",
    "sideBar.background": "#1f1f1f",
    "editor.lineHighlightBackground": "#272736",
    "editor.lineHighlightBorder": "#282837",
    "editor.wordHighlightBackground": "#4d596644",
    "editor.wordHighlightBorder": "#4d5966",
    "editorBracketHighlight.foreground1": "#a2a2a2",
    "editorBracketHighlight.foreground2": "#9a7da2",
    "editorBracketHighlight.foreground3": "#a2a2a2",
    "editorBracketHighlight.foreground4": "#9a7da2",
    "editorBracketHighlight.foreground5": "#a2a2a2",
    "editorBracketHighlight.foreground6": "#9a7da2",
    "editorBracketHighlight.unexpectedBracket.background": "#3a1b1b",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF5370",
    "git.blame.editorDecorationForeground": "#445044"
  },
  "semanticTokenColors": {
    "namespace": "#7c8092",
    "macro": "#409d75",
    "typeParameter": {
      "italic": true
    },
    "function.static": {
      "italic": true
    },
    "class.declaration": {
      "fontStyle": "bold"
    },
    "class.definition": {
      "fontStyle": "bold"
    },
    "class.constructorOrDestructor": "#68a9f3",
    "type.defaultLibrary": "#a167b6",
    "class.deduced": "#a167b6",
    "variable.readonly": "#bfb1d4",
    "bracket": "#a2a2a2"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#454c52"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#c7c7c9"
      }
    },
    {
      "name": "Constant Variable",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#bfb1d4"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#cececf"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#a167b6"
      }
    },
    {
      "name": "Storage Modifier, noexcept",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#a167b6"
      }
    },
    {
      "name": "Requires Keyword",
      "scope": [
        "keyword.other.requires"
      ],
      "settings": {
        "foreground": "#a167b6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#a167b6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.template.cpp"
      ],
      "settings": {
        "foreground": "#c7c7c9"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#97c8ef"
      }
    },
    {
      "name": "Cast",
      "scope": [
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#4f799a"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "Primitive Type",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#a167b6"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#9ab1cf"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#81a063"
      }
    },
    {
      "name": "Class, Struct, Type Declaration",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.typedef"
      ],
      "settings": {
        "foreground": "#9ab1cf"
      }
    },
    {
      "name": "Namespace Prefix",
      "scope": [
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#7c8092"
      }
    },
    {
      "name": "Lambda Return Type",
      "scope": [
        "storage.type.return-type.lambda.cpp"
      ],
      "settings": {
        "foreground": "#c2a880"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#68a9f3"
      }
    },
    {
      "name": "Member Function",
      "scope": [
        "entity.name.function.definition",
        "keyword.other.operator.overload.cpp"
      ],
      "settings": {
        "foreground": "#68a9f3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Static Function",
      "scope": [
        "entity.name.function.member.static"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Special Function",
      "scope": [
        "entity.name.function.definition.special"
      ],
      "settings": {
        "foreground": "#8AA4F1",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#409d75"
      }
    },
    {
      "name": "Property/Member Variables",
      "scope": [
        "variable.other.property",
        "variable.other.constant.property",
        "variable.other.object.property",
        "meta.body.class variable.other.declare"
      ],
      "settings": {
        "foreground": "#e9a0a4"
      }
    },
    {
      "name": "Local Variable Declaration",
      "scope": [
        "meta.body.function.definition variable.other.declare"
      ],
      "settings": {
        "foreground": "#c7c7c9"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#e9a0a4"
      }
    },
    {
      "name": "Number, Constant, Tag Attribute, Embedded",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#f99f67"
      }
    },
    {
      "name": "Argument",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#cacaca",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword (Other)",
      "scope": [
        "keyword.other.unit",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#a167b6"
      }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#87c075"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#B2CCD6"
      }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Language methods",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#f83ba3"
      }
    },
    {
      "name": "entity.name.method.js",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "meta.method.js",
      "scope": [
        "meta.class-method.js entity.name.function.js",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "TypeScript Primitive",
      "scope": [
        "support.type.primitive.ts"
      ],
      "settings": {
        "foreground": "#3da779"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a167b6"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "text.html.basic entity.other.attribute-name.html",
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9ab1cf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#9ab1cf"
      }
    },
    {
      "name": "CSS IDs",
      "scope": [
        "source.sass keyword.control"
      ],
      "settings": {
        "foreground": "#68a9f3"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#87c075"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4cadd3"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": {
        "foreground": "#8AA4F1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#97c8ef",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c4c4c4"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c4c4c4"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#be9797"
      }
    },
    {
      "name": "JSON Key - Level 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c5b793"
      }
    },
    {
      "name": "JSON Key - Level 4",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#93c093"
      }
    },
    {
      "name": "JSON Key - Level 5",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#97c3c7"
      }
    },
    {
      "name": "JSON Key - Level 6",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#959dc5"
      }
    },
    {
      "name": "JSON Key - Level 7",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ba8ec2"
      }
    },
    {
      "name": "JSON Key - Level 8",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c08f8f"
      }
    },
    {
      "name": "Markdown - Plain",
      "scope": [
        "text.html.markdown",
        "punctuation.definition.list_item.markdown"
      ],
      "settings": {
        "foreground": "#dadada"
      }
    },
    {
      "name": "Markdown - Markup Raw Inline",
      "scope": [
        "text.html.markdown markup.inline.raw.markdown",
        "text.html.markdown markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#64a6dc"
      }
    },
    {
      "name": "Markdown - Markup Raw Inline Punctuation",
      "scope": [
        "text.html.markdown markup.inline.raw.markdown punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#65737E"
      }
    },
    {
      "name": "Markdown - Heading",
      "scope": [
        "markdown.heading",
        "markup.heading | markup.heading entity.name",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#c1e88d"
      }
    },
    {
      "name": "Markup - Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f07178",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup - Bold",
      "scope": [
        "markup.bold",
        "markup.bold string"
      ],
      "settings": {
        "foreground": "#e0b569",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Bold-Italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold",
        "markup.quote markup.bold",
        "markup.bold markup.italic string",
        "markup.italic markup.bold string",
        "markup.quote markup.bold string"
      ],
      "settings": {
        "foreground": "#f07178",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Underline",
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "foreground": "#e6aa82",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown - Blockquote",
      "scope": [
        "markup.quote punctuation.definition.blockquote.markdown"
      ],
      "settings": {
        "foreground": "#65737E"
      }
    },
    {
      "name": "Markup - Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#65737E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Link",
      "scope": [
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#72aad7"
      }
    },
    {
      "name": "Markdown - Link Description",
      "scope": [
        "string.other.link.description.title.markdown"
      ],
      "settings": {
        "foreground": "#C681E1"
      }
    },
    {
      "name": "Markdown - Link Anchor",
      "scope": [
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#9ab1cf"
      }
    },
    {
      "name": "Markup - Raw Block",
      "scope": [
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#aa94e1"
      }
    },
    {
      "name": "Markdown - Raw Block Fenced",
      "scope": [
        "markup.raw.block.fenced.markdown",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#aa94e1"
      }
    },
    {
      "name": "Markdown - Fenced Code Block",
      "scope": [
        "punctuation.definition.fenced.markdown"
      ],
      "settings": {
        "foreground": "#aa94e1"
      }
    },
    {
      "name": "Markdown - Fenced Code Block Variable",
      "scope": [
        "markup.raw.block.fenced.markdown",
        "variable.language.fenced.markdown",
        "punctuation.section.class.end"
      ],
      "settings": {
        "foreground": "#dadada"
      }
    },
    {
      "name": "Markdown - Fenced Language",
      "scope": [
        "variable.language.fenced.markdown"
      ],
      "settings": {
        "foreground": "#65737E"
      }
    },
    {
      "name": "Markdown - Separator",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#65737E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup - Table",
      "scope": [
        "markup.table"
      ],
      "settings": {
        "foreground": "#dadada"
      }
    },
    {
      "name": "YAML - Key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#c4c4c4"
      }
    }
  ]
}