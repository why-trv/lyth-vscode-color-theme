  "semanticTokenColors": {
    "namespace": "#b96c7c",
    "macro": "#3c926d",
    "typeParameter": {
      "italic": true
    },
    "type": "#de8d9d",
    "type.deduced": "#826ac0",
    "type.defaultLibrary": "#bc85d5",
    "function.static": {
      "italic": true
    },
    "class.declaration": {
      "fontStyle": "bold"
    },
    "class.definition": {
      "fontStyle": "bold"
    },
    "class.constructorOrDestructor": "#62b7f3",
    "variable.readonly": "#c6c3e0",
    "bracket": "#a37d88"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#565360"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Constant Variable",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c6c3e0"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#d7d7d7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ec3f4b"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#826ac0"
      }
    },
    {
      "name": "Storage Modifier, noexcept",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#826ac0"
      }
    },
    {
      "name": "Requires Keyword",
      "scope": [
        "keyword.other.requires"
      ],
      "settings": {
        "foreground": "#826ac0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#826ac0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#868686"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.template.cpp"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#98cde7"
      }
    },
    {
      "name": "Pointer and Reference",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#98cde7"
      }
    },
    {
      "name": "Cast",
      "scope": [
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#826ac0"
      }
    },
    {
      "name": "Static Cast",
      "scope": [
        "keyword.operator.cast.static_cast"
      ],
      "settings": {
        "foreground": "#62528c"
      }
    },
    {
      "name": "Dynamic Cast",
      "scope": [
        "keyword.operator.cast.dynamic_cast"
      ],
      "settings": {
        "foreground": "#8f78ce"
      }
    },
    {
      "name": "Reinterpret Cast",
      "scope": [
        "keyword.operator.cast.reinterpret_cast"
      ],
      "settings": {
        "foreground": "#8f78ce"
      }
    },
    {
      "name": "Const Cast",
      "scope": [
        "keyword.operator.cast.const_cast"
      ],
      "settings": {
        "foreground": "#8f78ce"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#dc686d"
      }
    },
    {
      "name": "Primitive Type",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.built-in.primitive",
        "storage.type.built-in.primitive.cpp"
      ],
      "settings": {
        "foreground": "#bc85d5"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.ts",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#de8d9d"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#da9193"
      }
    },
    {
      "name": "Class, Struct, Type Declaration",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.typedef"
      ],
      "settings": {
        "foreground": "#de8d9d"
      }
    },
    {
      "name": "Scope Resolution",
      "scope": [
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#de8d9d"
      }
    },
    {
      "name": "Lambda Return Type",
      "scope": [
        "storage.type.return-type.lambda.cpp"
      ],
      "settings": {
        "foreground": "#c6a777"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
