{
  "name": "Lyth Dark Warm",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1c1c1c",
    "editor.foreground": "#cecece",
    "activityBarBadge.background": "#007acc",
    "sideBarTitle.foreground": "#bbbbbb",
    "sideBar.background": "#1b1b1b",
    "editorCursor.foreground": "#ff7f00",
    "editorCursor.background": "#000000",
    "editor.lineHighlightBackground": "#2f221b",
    "editor.lineHighlightBorder": "#2f221b",
    "editor.wordHighlightBackground": "#5d4c533a",
    "editor.wordHighlightBorder": "#5d4c53",
    "editorBracketHighlight.foreground1": "#8e9775",
    "editorBracketHighlight.foreground2": "#a38f70",
    "editorBracketHighlight.foreground3": "#8e9775",
    "editorBracketHighlight.foreground4": "#a38f70",
    "editorBracketHighlight.foreground5": "#8e9775",
    "editorBracketHighlight.foreground6": "#a38f70",
    "editorBracketHighlight.unexpectedBracket.background": "#14240e",
    "editorBracketHighlight.unexpectedBracket.foreground": "#24ac1b",
    "git.blame.editorDecorationForeground": "#3f4756"
  },
  "semanticTokenColors": {
    "namespace": "#7d855c",
    "macro": "#7677bb",
    "typeParameter": {
      "italic": true
    },
    "function.static": {
      "italic": true
    },
    "class.declaration": {
      "fontStyle": "bold"
    },
    "class.definition": {
      "fontStyle": "bold"
    },
    "class.constructorOrDestructor": "#ec8da9",
    "type.defaultLibrary": "#b7622b",
    "class.deduced": "#b7622b",
    "variable.readonly": "#dec0b1",
    "bracket": "#8e9775"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f524c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Constant Variable",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#dec0b1"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#d7d7d7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#17a50c"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#b7622b"
      }
    },
    {
      "name": "Storage Modifier, noexcept",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#b7622b"
      }
    },
    {
      "name": "Requires Keyword",
      "scope": [
        "keyword.other.requires"
      ],
      "settings": {
        "foreground": "#b7622b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#b7622b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.template.cpp"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e6b3ca"
      }
    },
    {
      "name": "Pointer and Reference",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#e6b3ca"
      }
    },
    {
      "name": "Cast",
      "scope": [
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#864d2a"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#5fa64b"
      }
    },
    {
      "name": "Primitive Type",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#c8942e"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#a3b065"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#91a5e0"
      }
    },
    {
      "name": "Class, Struct, Type Declaration",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.typedef"
      ],
      "settings": {
        "foreground": "#a3b065"
      }
    },
    {
      "name": "Namespace Prefix",
      "scope": [
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#7d855c"
      }
    },
    {
      "name": "Lambda Return Type",
      "scope": [
        "storage.type.return-type.lambda.cpp"
      ],
      "settings": {
        "foreground": "#72bbbe"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#ec8da9"
      }
    },
    {
      "name": "Member Function",
      "scope": [
        "entity.name.function.definition",
        "keyword.other.operator.overload.cpp"
      ],
      "settings": {
        "foreground": "#ec8da9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Static Function",
      "scope": [
        "entity.name.function.member.static"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Special Function",
      "scope": [
        "entity.name.function.definition.special"
      ],
      "settings": {
        "foreground": "#d88f82",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#7677bb"
      }
    },
    {
      "name": "Property/Member Variables",
      "scope": [
        "variable.other.property",
        "variable.other.constant.property",
        "variable.other.object.property",
        "meta.body.class variable.other.declare"
      ],
      "settings": {
        "foreground": "#c5cbae"
      }
    },
    {
      "name": "Local Variable Declaration",
      "scope": [
        "meta.body.function.definition variable.other.declare"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#c5cbae"
      }
    },
    {
      "name": "Number, Constant, Tag Attribute, Embedded",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#47cba5"
      }
    },
    {
      "name": "Argument",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword (Other)",
      "scope": [
        "keyword.other.unit",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#b7622b"
      }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#8cb8ff"
      }
    },
    {
      "name": "String Template Expression",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#e1afed"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#B2CCD6"
      }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Language methods",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#9b9500"
      }
    },
    {
      "name": "entity.name.method.js",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "meta.method.js",
      "scope": [
        "meta.class-method.js entity.name.function.js",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "TypeScript Primitive",
      "scope": [
        "support.type.primitive.ts"
      ],
      "settings": {
        "foreground": "#be9a2c"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b7622b"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "text.html.basic entity.other.attribute-name.html",
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a3b065",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Classes",
      "scope": [
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#a3b065"
      }
    },
    {
      "name": "CSS IDs",
      "scope": [
        "source.sass keyword.control"
      ],
      "settings": {
        "foreground": "#ec8da9"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8cb8ff"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#17a50c"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#da9915"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#c38abb"
      }
    },
    {
      "name": "Escape Characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#b6aaff"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": {
        "foreground": "#d88f82",
        "fontStyle": "italic"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#e6b3ca",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#c1c1c1"
      }
