{
  "name": "Lyth Dark Mono",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1c1c1c",
    "editor.foreground": "#cecece",
    "editor.lineHighlightBackground": "#252525",
    "editor.lineHighlightBorder": "#252525",
    "editor.inactiveLineHighlightBackground": "#1f1f1f",
    "editor.wordHighlightBackground": "#5252523a",
    "editor.wordHighlightBorder": "#525252",
    "editor.selectionBackground": "#2e2e2e",
    "editor.inactiveSelectionBackground": "#292929",
    "editor.selectionHighlightBackground": "#262626",
    "editor.selectionHighlightBorder": "#3a3a3a",
    "editor.findMatchBackground": "#333333",
    "editor.findMatchHighlightBackground": "#2e2e2e",
    "editor.findMatchHighlightBorder": "#bebebe",
    "editorCursor.foreground": "#aeaeae",
    "editorCursor.background": "#000000",
    "editorBracketHighlight.foreground1": "#898989",
    "editorBracketHighlight.foreground2": "#898989",
    "editorBracketHighlight.foreground3": "#898989",
    "editorBracketHighlight.foreground4": "#898989",
    "editorBracketHighlight.foreground5": "#898989",
    "editorBracketHighlight.foreground6": "#898989",
    "editorBracketHighlight.unexpectedBracket.foreground": "#8f8f8f",
    "editorBracketHighlight.unexpectedBracket.background": "#1f1f1f",
    "list.activeSelectionBackground": "#383838",
    "list.inactiveSelectionBackground": "#383838",
    "list.focusOutline": "#636363",
    "sideBar.background": "#1e1e1e",
    "sideBar.border": "#181818",
    "sideBarTitle.foreground": "#aeaeae",
    "sideBarSectionHeader.background": "#242424",
    "sideBarSectionHeader.border": "#181818",
    "activityBarBadge.background": "#717171",
    "statusBar.border": "#181818",
    "scrollbarSlider.background": "#6363632b",
    "scrollbarSlider.hoverBackground": "#6363634d",
    "git.blame.editorDecorationForeground": "#474747"
  },
  "semanticTokenColors": {
    "namespace": "#868686",
    "macro": "#7f7f7f",
    "typeParameter": {
      "italic": true
    },
    "function.static": {
      "italic": true
    },
    "class.declaration": {
      "fontStyle": "bold"
    },
    "class.definition": {
      "fontStyle": "bold"
    },
    "class.constructorOrDestructor": "#aeaeae",
    "type.defaultLibrary": "#7c7c7c",
    "class.deduced": "#7c7c7c",
    "variable.readonly": "#c7c7c7",
    "bracket": "#898989"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Constant Variable",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#d7d7d7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#7c7c7c"
      }
    },
    {
      "name": "Storage Modifier, noexcept",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#7c7c7c"
      }
    },
    {
      "name": "Requires Keyword",
      "scope": [
        "keyword.other.requires"
      ],
      "settings": {
        "foreground": "#7c7c7c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#7c7c7c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
      ],
      "settings": {
        "foreground": "#868686"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.template.cpp"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c4c4c4"
      }
    },
    {
      "name": "Pointer and Reference",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#c4c4c4"
      }
    },
    {
      "name": "Cast",
      "scope": [
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#7c7c7c"
      }
    },
    {
      "name": "Static Cast",
      "scope": [
        "keyword.operator.cast.static_cast"
      ],
      "settings": {
        "foreground": "#5d5d5d"
      }
    },
    {
      "name": "Dynamic Cast",
      "scope": [
        "keyword.operator.cast.dynamic_cast"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "name": "Reinterpret Cast",
      "scope": [
        "keyword.operator.cast.reinterpret_cast"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "name": "Const Cast",
      "scope": [
        "keyword.operator.cast.const_cast"
      ],
      "settings": {
        "foreground": "#898989"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#919191"
      }
    },
    {
      "name": "Primitive Type",
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#9e9e9e"
      }
    },
    {
      "name": "Class, Support",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter"
      ],
      "settings": {
        "foreground": "#a8a8a8"
      }
    },
    {
      "name": "Template Argument Name",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#a8a8a8"
      }
    },
    {
      "name": "Class, Struct, Type Declaration",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.typedef"
      ],
      "settings": {
        "foreground": "#a8a8a8"
      }
    },
    {
      "name": "Scope Resolution",
      "scope": [
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#a8a8a8"
      }
    },
    {
      "name": "Lambda Return Type",
      "scope": [
        "storage.type.return-type.lambda.cpp"
      ],
      "settings": {
        "foreground": "#acacac"
      }
    },
    {
      "name": "Function, Special Method",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#aeaeae"
      }
    },
    {
      "name": "Member Function",
      "scope": [
        "entity.name.function.definition",
        "keyword.other.operator.overload.cpp"
      ],
      "settings": {
        "foreground": "#aeaeae",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Static Function",
      "scope": [
        "entity.name.function.member.static"
      ],
      "settings": {
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Special Function",
      "scope": [
        "entity.name.function.definition.special"
      ],
      "settings": {
        "foreground": "#a4a4a4",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#7f7f7f"
      }
    },
    {
      "name": "Property/Member Variables",
      "scope": [
        "variable.other.property",
        "variable.other.constant.property",
        "variable.other.object.property",
        "meta.body.class variable.other.declare"
      ],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "name": "Local Variable Declaration",
      "scope": [
        "meta.body.function.definition variable.other.declare"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "Other Variable, String Link",
      "scope": [
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "name": "Number, Constant, Tag Attribute, Embedded",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "constant.escape"
      ],
      "settings": {
        "foreground": "#b1b1b1"
      }
    },
    {
      "name": "Number Exponent, Suffix etc.",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#989898"
      }
    },
    {
      "name": "Argument",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword (Other)",
      "scope": [
        "keyword.other"
      ],
      "settings": {
        "foreground": "#7c7c7c"
      }
    },
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#b7b7b7"
      }
    },
    {
      "name": "String Template Expression",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#c4c4c4"
      }
    },
    {
      "name": "CSS Class and Support",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#B2CCD6"
      }
    },
    {
      "name": "Sub-methods",
      "scope": [
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#FF5370"
      }
    },
    {
      "name": "Language methods",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#8f8f8f"
      }
    },
    {
      "name": "entity.name.method.js",
      "scope": [
        "entity.name.method.js"
      ],
      "settings": {
        "foreground": "#82AAFF",
        "fontStyle": "italic"
      }
