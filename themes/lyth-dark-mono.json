        "foreground": "#a8a8a8"
      }
    },
    {
      "name": "CSS IDs",
      "scope": [
        "source.sass keyword.control"
      ],
      "settings": {
        "foreground": "#aeaeae"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b7b7b7"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#a7a7a7"
      }
    },
    {
