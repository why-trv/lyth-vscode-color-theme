{
  "name": "Lyth Dark Lum Tweak",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1c1c1c",
    "editor.foreground": "#d0d0d0",
    "editor.lineHighlightBackground": "#252431",
    "editor.lineHighlightBorder": "#252431",
    "editor.inactiveLineHighlightBackground": "#202020",
    "editor.wordHighlightBackground": "#46565e3a",
    "editor.wordHighlightBorder": "#46565e",
    "editor.selectionBackground": "#2e2d38",
    "editor.inactiveSelectionBackground": "#29292e",
    "editor.selectionHighlightBackground": "#27262c",
    "editor.selectionHighlightBorder": "#3b3a45",
    "editor.findMatchBackground": "#6d000f",
    "editor.findMatchHighlightBackground": "#660009",
    "editor.findMatchHighlightBorder": "#c0becd",
    "editorCursor.foreground": "#b194ff",
    "editorCursor.background": "#000000",
    "editorIndentGuide.background": "#272727",
    "editorBracketHighlight.foreground1": "#a57f8a",
    "editorBracketHighlight.foreground2": "#8d85a7",
    "editorBracketHighlight.foreground3": "#a57f8a",
    "editorBracketHighlight.foreground4": "#8d85a7",
    "editorBracketHighlight.foreground5": "#a57f8a",
    "editorBracketHighlight.foreground6": "#8d85a7",
    "editorBracketHighlight.unexpectedBracket.foreground": "#f64a53",
    "editorBracketHighlight.unexpectedBracket.background": "#321617",
    "editorBracketPairGuide.activeBackground1": "#5f3d48",
    "editorBracketPairGuide.activeBackground2": "#4a4361",
    "editorBracketPairGuide.activeBackground3": "#5f3d48",
    "editorBracketPairGuide.activeBackground4": "#4a4361",
    "editorBracketPairGuide.activeBackground5": "#5f3d48",
    "editorBracketPairGuide.activeBackground6": "#4a4361",
    "list.activeSelectionBackground": "#133966",
    "list.inactiveSelectionBackground": "#2e3a48",
    "list.focusOutline": "#0060cd",
    "sideBar.background": "#1f1f1f",
    "sideBar.border": "#191919",
    "sideBarTitle.foreground": "#b0b0b0",
    "sideBarSectionHeader.background": "#242427",
    "sideBarSectionHeader.border": "#191919",
    "activityBarBadge.background": "#1376c6",
    "statusBar.border": "#191919",
    "scrollbarSlider.background": "#645e8a2b",
    "scrollbarSlider.hoverBackground": "#645a9a4d",
    "git.blame.editorDecorationForeground": "#404c3f"
  },
  "semanticTokenColors": {
    "namespace": "#bb6d7e",
    "macro": "#3e946f",
    "typeParameter": {
      "italic": true
    },
    "function.static": {
      "italic": true
    },
    "class.declaration": {
      "fontStyle": "bold"
    },
    "class.definition": {
      "fontStyle": "bold"
    },
    "class.constructorOrDestructor": "#64b9f5",
    "type.defaultLibrary": "#846cc2",
    "class.deduced": "#846cc2",
    "variable.readonly": "#c9c6e3",
    "bracket": "#a57f8a"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#575461"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Constant Variable",
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c9c6e3"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#dadada"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ee424d"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#846cc2"
      }
    },
    {
      "name": "Storage Modifier, noexcept",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#846cc2"
      }
    },
    {
      "name": "Requires Keyword",
      "scope": [
        "keyword.other.requires"
      ],
      "settings": {
        "foreground": "#846cc2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Keywords",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#846cc2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Misc",
      "scope": [
        "constant.other.color",
        "punctuation",
        "meta.tag",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution"
